# Copy to .env and fill in. .env is git-ignored.
# Keep comments on their own lines: docker compose reads this file too.

# --- Qdrant (docker compose up -d) ---
QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=rag_chunks
# Only for a shared/remote Qdrant; the local one runs without a key.
# QDRANT_API_KEY=

# --- Embeddings (Ollama) + reranker (sentence-transformers CrossEncoder, runs in Python) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_DIM=1024
RERANKER_PROVIDER=sentence-transformers
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM (Ollama, local) ---
# Ollama serves an OpenAI-compatible API, so src/generate.py uses the openai SDK with this base URL.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TEMPERATURE=0
# The openai SDK needs a non-empty key; Ollama ignores it.
LLM_API_KEY=ollama

# --- AMD GPU only (RX 6500M); NVIDIA users leave commented ---
# Load .env BEFORE importing torch, or these have no effect.
# Treat the RX 6500M (gfx1034) as gfx1030 so ROCm accepts it.
# HSA_OVERRIDE_GFX_VERSION=10.3.0
# Use only the discrete GPU; the integrated Vega (device 1) hangs under the override.
# HIP_VISIBLE_DEVICES=0
# The reranker on this GPU crashed in 5 of 6 runs (unsupported chip), so run it on the CPU.
# Ollama (embeddings + LLM) keeps the GPU; its own GPU code works fine.
# RERANKER_DEVICE=cpu
